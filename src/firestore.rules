rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function bookingWindowLooksValid() {
      return request.resource.data.startAt is string
        && request.resource.data.endAt is string
        && request.resource.data.startAt < request.resource.data.endAt;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mrga.vehicles@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /availabilityBlocks/{bookingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly([
          'clientName',
          'clientPhone',
          'vehicleId',
          'vehicleName',
          'startAt',
          'endAt',
          'price',
          'status',
          'createdAt'
        ])
        && request.resource.data.clientName is string
        && request.resource.data.clientPhone is string
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleName is string
        && request.resource.data.price is number
        && request.resource.data.status == 'pending'
        && bookingWindowLooksValid()
      );
      allow read, update, delete: if isAdmin();
    }
  }
}
